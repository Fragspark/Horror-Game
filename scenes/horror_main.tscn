[sub_resource type="Shader" id="Shader_screen_postfx"]
code = "shader_type canvas_item;
render_mode unshaded;

uniform sampler2D screen_texture : hint_screen_texture, repeat_disable, filter_linear;
uniform float vignette_strength : hint_range(0.0, 1.0) = 0.35;
uniform float vignette_start : hint_range(0.0, 1.0) = 0.22;
uniform float vignette_end : hint_range(0.2, 1.6) = 1.05;
uniform float grain_amount : hint_range(0.0, 0.12) = 0.028;
uniform float grain_speed : hint_range(0.0, 4.0) = 1.0;
uniform float aspect_ratio : hint_range(0.5, 3.0) = 1.7777778;
uniform float mottle_amount : hint_range(0.0, 0.1) = 0.012;

float hash21(vec2 p) {
	p = fract(p * vec2(123.34, 456.21));
	p += dot(p, p + 45.32);
	return fract(p.x * p.y);
}

void fragment() {
	vec3 col = texture(screen_texture, SCREEN_UV).rgb;

	vec2 centered = SCREEN_UV - vec2(0.5);
	centered.x *= aspect_ratio;
	float dist = length(centered);
	float vignette = smoothstep(vignette_start, vignette_end, dist);
	vignette = pow(vignette, 1.35);
	col *= 1.0 - clamp(vignette_strength * vignette, 0.0, 1.0);

	col *= mix(vec3(1.0), vec3(0.88, 0.94, 1.05), vignette * 0.7);

	float frame = floor(TIME * 24.0 * grain_speed);
	float grain = hash21(FRAGCOORD.xy + vec2(frame * 37.0, frame * 17.0)) - 0.5;
	col += grain * grain_amount * (0.55 + 0.45 * (1.0 - dist));

	float mottle = hash21(floor(FRAGCOORD.xy / 3.0) + vec2(frame * 0.5)) - 0.5;
	col += mottle * mottle_amount;

	COLOR = vec4(max(col, vec3(0.0)), 1.0);
}
"

